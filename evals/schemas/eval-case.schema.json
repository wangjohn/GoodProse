{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:goodprose:schema:eval-case:v1",
  "title": "GoodProse evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "split", "input", "expected", "provenance"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "split": {"enum": ["dev", "test", "private_test"]},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_material", "channel", "audience", "objective", "voice_profile_id"],
      "properties": {
        "source_material": {"type": "string", "minLength": 1},
        "channel": {"enum": ["email", "blog_post", "internal_memo"]},
        "audience": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "voice_profile_id": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "content"],
            "properties": {
              "kind": {"enum": ["notes", "reference", "policy", "constraint", "other"]},
              "label": {"type": "string"},
              "content": {"type": "string"}
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_facts", "forbidden_claims"],
      "properties": {
        "gold_output_path": {"type": "string"},
        "required_facts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "optional_facts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden_claims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_call_to_action": {"type": "string"},
        "acceptable_variations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_group", "target_document_ids", "input_origin"],
      "properties": {
        "lineage_group": {"type": "string", "minLength": 1},
        "target_document_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "input_origin": {"enum": ["real_source_material", "paired_history", "synthetic_degradation"]},
        "reviewers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
