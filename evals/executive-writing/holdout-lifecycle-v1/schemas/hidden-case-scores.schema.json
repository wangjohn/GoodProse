{
  "$defs": {
    "HiddenAudit": {
      "additionalProperties": false,
      "properties": {
        "evaluator_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Evaluator Run Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        }
      },
      "required": [
        "recorded_at",
        "evaluator_run_id"
      ],
      "title": "HiddenAudit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Hidden-boundary record: opaque IDs, registered numbers, nothing else.",
  "properties": {
    "audit": {
      "$ref": "#/$defs/HiddenAudit"
    },
    "candidate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "gate_passes": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Gate Passes",
      "type": "object"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    }
  },
  "required": [
    "case_id",
    "candidate_id",
    "metrics",
    "gate_passes",
    "audit"
  ],
  "title": "HiddenCaseScores",
  "type": "object"
}
