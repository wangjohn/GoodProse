{
  "$defs": {
    "AggregateUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "requests": {
          "minimum": 0,
          "title": "Requests",
          "type": "integer"
        },
        "usd_cost": {
          "minimum": 0,
          "title": "Usd Cost",
          "type": "number"
        }
      },
      "required": [
        "requests",
        "input_tokens",
        "output_tokens",
        "usd_cost"
      ],
      "title": "AggregateUsage",
      "type": "object"
    },
    "ReceiptEnvelope": {
      "additionalProperties": false,
      "properties": {
        "access_posture": {
          "enum": [
            "sealed",
            "procedurally_held_out"
          ],
          "title": "Access Posture",
          "type": "string"
        },
        "authenticator": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authenticator"
        },
        "code_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Code Revision",
          "type": "string"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        },
        "prior_receipt_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prior Receipt Sha256"
        },
        "protocol_id": {
          "const": "holdout-lifecycle-v1",
          "title": "Protocol Id",
          "type": "string"
        },
        "protocol_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol Sha256",
          "type": "string"
        },
        "receipt_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Sha256"
        },
        "registration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registration Sha256",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/AggregateUsage"
        }
      },
      "required": [
        "protocol_id",
        "protocol_sha256",
        "code_revision",
        "registration_sha256",
        "access_posture",
        "executed_at",
        "usage"
      ],
      "title": "ReceiptEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregate_metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Aggregate Metrics",
      "type": "object"
    },
    "b1_accepted_candidate_ordinal": {
      "minimum": 1,
      "title": "B1 Accepted Candidate Ordinal",
      "type": "integer"
    },
    "b1_claim_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "B1 Claim Sha256",
      "type": "string"
    },
    "canary_commitment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canary Commitment Sha256",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Identity Sha256",
      "type": "string"
    },
    "content_commitment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Commitment Sha256",
      "type": "string"
    },
    "cumulative_regressions": {
      "minimum": 0,
      "title": "Cumulative Regressions",
      "type": "integer"
    },
    "envelope": {
      "$ref": "#/$defs/ReceiptEnvelope"
    },
    "evaluated_case_count": {
      "minimum": 1,
      "title": "Evaluated Case Count",
      "type": "integer"
    },
    "gates_met": {
      "title": "Gates Met",
      "type": "boolean"
    },
    "hard_gate_pass_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Hard Gate Pass Counts",
      "type": "object"
    },
    "hard_gate_pass_rates": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Hard Gate Pass Rates",
      "type": "object"
    },
    "kind": {
      "const": "tier_b2",
      "title": "Kind",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "accepted",
        "not_accepted",
        "advancement_blocked"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "primary_metric": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Primary Metric",
      "type": "string"
    },
    "primary_value": {
      "title": "Primary Value",
      "type": "number"
    },
    "query_index": {
      "minimum": 1,
      "title": "Query Index",
      "type": "integer"
    },
    "reference_value": {
      "title": "Reference Value",
      "type": "number"
    },
    "regressed": {
      "title": "Regressed",
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "envelope",
    "query_index",
    "candidate_id",
    "candidate_identity_sha256",
    "b1_claim_sha256",
    "b1_accepted_candidate_ordinal",
    "content_commitment_sha256",
    "canary_commitment_sha256",
    "aggregate_metrics",
    "evaluated_case_count",
    "hard_gate_pass_counts",
    "hard_gate_pass_rates",
    "gates_met",
    "primary_metric",
    "primary_value",
    "reference_value",
    "regressed",
    "cumulative_regressions",
    "outcome"
  ],
  "title": "TierB2Receipt",
  "type": "object"
}
