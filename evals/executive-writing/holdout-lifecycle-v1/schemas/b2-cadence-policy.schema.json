{
  "additionalProperties": false,
  "description": "Frozen cadence/promotion policy inherited from Tier B1 evidence.",
  "properties": {
    "eligible_b1_evidence_fields": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Eligible B1 Evidence Fields",
      "type": "array"
    },
    "max_queries": {
      "minimum": 1,
      "title": "Max Queries",
      "type": "integer"
    },
    "minimum_accepted_candidate_gap": {
      "minimum": 0,
      "title": "Minimum Accepted Candidate Gap",
      "type": "integer"
    },
    "minimum_primary_improvement": {
      "minimum": 0,
      "title": "Minimum Primary Improvement",
      "type": "number"
    },
    "reference_aggregates": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Reference Aggregates",
      "type": "object"
    },
    "reference_candidate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "title": "Reference Candidate Id",
      "type": "string"
    },
    "reference_candidate_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reference Candidate Identity Sha256",
      "type": "string"
    },
    "regression_block_threshold": {
      "minimum": 1,
      "title": "Regression Block Threshold",
      "type": "integer"
    },
    "regression_margin": {
      "minimum": 0,
      "title": "Regression Margin",
      "type": "number"
    }
  },
  "required": [
    "eligible_b1_evidence_fields",
    "minimum_primary_improvement",
    "max_queries",
    "minimum_accepted_candidate_gap",
    "reference_candidate_id",
    "reference_candidate_identity_sha256",
    "reference_aggregates",
    "regression_margin",
    "regression_block_threshold"
  ],
  "title": "B2CadencePolicy",
  "type": "object"
}
