{
  "$defs": {
    "B1PromotionClaim": {
      "additionalProperties": false,
      "properties": {
        "accepted_candidate_ordinal": {
          "minimum": 1,
          "title": "Accepted Candidate Ordinal",
          "type": "integer"
        },
        "evidence": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Evidence",
          "type": "object"
        },
        "evidence_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Artifact Sha256",
          "type": "string"
        },
        "milestone": {
          "default": false,
          "title": "Milestone",
          "type": "boolean"
        },
        "primary_improvement": {
          "title": "Primary Improvement",
          "type": "number"
        }
      },
      "required": [
        "evidence",
        "primary_improvement",
        "accepted_candidate_ordinal",
        "evidence_artifact_sha256"
      ],
      "title": "B1PromotionClaim",
      "type": "object"
    },
    "CandidateIdentity": {
      "additionalProperties": false,
      "description": "Every behavior-affecting field required by ``evals/AGENTS.md``.",
      "properties": {
        "adapter_checkpoint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Checkpoint Sha256",
          "type": "string"
        },
        "base_model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Base Model",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "code_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Code Revision",
          "type": "string"
        },
        "cost_token_accounting_policy": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Cost Token Accounting Policy",
          "type": "string"
        },
        "dataset_split_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Dataset Split Id",
          "type": "string"
        },
        "decoding_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decoding Config Sha256",
          "type": "string"
        },
        "grader_identifier": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Grader Identifier",
          "type": "string"
        },
        "grader_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Grader Version",
          "type": "string"
        },
        "hardware_provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Hardware Provider",
          "type": "string"
        },
        "inference_provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Inference Provider",
          "type": "string"
        },
        "model_identifier": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Identifier",
          "type": "string"
        },
        "model_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "retrieval_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Retrieval Config Sha256",
          "type": "string"
        },
        "retrieval_corpus_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Retrieval Corpus Sha256",
          "type": "string"
        },
        "seed": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Seed",
          "type": "string"
        },
        "system_instructions_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "System Instructions Sha256",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "model_identifier",
        "model_version",
        "base_model",
        "adapter_checkpoint_sha256",
        "prompt_version",
        "system_instructions_sha256",
        "decoding_config_sha256",
        "inference_provider",
        "retrieval_corpus_sha256",
        "retrieval_config_sha256",
        "dataset_split_id",
        "grader_identifier",
        "grader_version",
        "seed",
        "code_revision",
        "hardware_provider",
        "cost_token_accounting_policy"
      ],
      "title": "CandidateIdentity",
      "type": "object"
    },
    "HiddenAudit": {
      "additionalProperties": false,
      "properties": {
        "evaluator_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Evaluator Run Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        }
      },
      "required": [
        "recorded_at",
        "evaluator_run_id"
      ],
      "title": "HiddenAudit",
      "type": "object"
    },
    "HiddenCaseScores": {
      "additionalProperties": false,
      "description": "Hidden-boundary record: opaque IDs, registered numbers, nothing else.",
      "properties": {
        "audit": {
          "$ref": "#/$defs/HiddenAudit"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "gate_passes": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Gate Passes",
          "type": "object"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "case_id",
        "candidate_id",
        "metrics",
        "gate_passes",
        "audit"
      ],
      "title": "HiddenCaseScores",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "b1_promotion_claim": {
      "$ref": "#/$defs/B1PromotionClaim"
    },
    "candidate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_identity": {
      "$ref": "#/$defs/CandidateIdentity"
    },
    "hidden_case_scores": {
      "items": {
        "$ref": "#/$defs/HiddenCaseScores"
      },
      "title": "Hidden Case Scores",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "candidate_identity",
    "b1_promotion_claim",
    "hidden_case_scores"
  ],
  "title": "B2QueryRequest",
  "type": "object"
}
