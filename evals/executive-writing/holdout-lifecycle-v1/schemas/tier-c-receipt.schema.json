{
  "$defs": {
    "AggregateUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "requests": {
          "minimum": 0,
          "title": "Requests",
          "type": "integer"
        },
        "usd_cost": {
          "minimum": 0,
          "title": "Usd Cost",
          "type": "number"
        }
      },
      "required": [
        "requests",
        "input_tokens",
        "output_tokens",
        "usd_cost"
      ],
      "title": "AggregateUsage",
      "type": "object"
    },
    "CandidateAggregate": {
      "additionalProperties": false,
      "properties": {
        "aggregate_metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Aggregate Metrics",
          "type": "object"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Identity Sha256",
          "type": "string"
        },
        "evaluated_case_count": {
          "minimum": 1,
          "title": "Evaluated Case Count",
          "type": "integer"
        },
        "gates_met": {
          "title": "Gates Met",
          "type": "boolean"
        },
        "hard_gate_pass_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Hard Gate Pass Counts",
          "type": "object"
        },
        "hard_gate_pass_rates": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Hard Gate Pass Rates",
          "type": "object"
        }
      },
      "required": [
        "candidate_id",
        "candidate_identity_sha256",
        "aggregate_metrics",
        "evaluated_case_count",
        "hard_gate_pass_counts",
        "hard_gate_pass_rates",
        "gates_met"
      ],
      "title": "CandidateAggregate",
      "type": "object"
    },
    "ReceiptEnvelope": {
      "additionalProperties": false,
      "properties": {
        "access_posture": {
          "enum": [
            "sealed",
            "procedurally_held_out"
          ],
          "title": "Access Posture",
          "type": "string"
        },
        "authenticator": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authenticator"
        },
        "code_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Code Revision",
          "type": "string"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        },
        "prior_receipt_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prior Receipt Sha256"
        },
        "protocol_id": {
          "const": "holdout-lifecycle-v1",
          "title": "Protocol Id",
          "type": "string"
        },
        "protocol_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol Sha256",
          "type": "string"
        },
        "receipt_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Sha256"
        },
        "registration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registration Sha256",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/AggregateUsage"
        }
      },
      "required": [
        "protocol_id",
        "protocol_sha256",
        "code_revision",
        "registration_sha256",
        "access_posture",
        "executed_at",
        "usage"
      ],
      "title": "ReceiptEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregates": {
      "items": {
        "$ref": "#/$defs/CandidateAggregate"
      },
      "maxItems": 5,
      "minItems": 3,
      "title": "Aggregates",
      "type": "array"
    },
    "canary_commitment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canary Commitment Sha256",
      "type": "string"
    },
    "content_commitment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Commitment Sha256",
      "type": "string"
    },
    "envelope": {
      "$ref": "#/$defs/ReceiptEnvelope"
    },
    "finalist_freeze_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Finalist Freeze Sha256",
      "type": "string"
    },
    "kind": {
      "const": "tier_c",
      "title": "Kind",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "completed",
        "no_hard_gate_passing_finalist"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "selected_candidate_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Candidate Id"
    },
    "selection_rule": {
      "const": "max_primary_among_hard_gate_passing_then_lexicographic_candidate_id",
      "title": "Selection Rule",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "envelope",
    "finalist_freeze_sha256",
    "content_commitment_sha256",
    "canary_commitment_sha256",
    "selection_rule",
    "aggregates",
    "selected_candidate_id",
    "outcome"
  ],
  "title": "TierCReceipt",
  "type": "object"
}
