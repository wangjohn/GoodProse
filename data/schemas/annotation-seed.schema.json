{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:goodprose:schema:annotation-seed:v1",
  "title": "GoodProse annotation seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "split", "input", "provenance"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation"]},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_material", "channel", "audience", "objective", "voice_profile_id"],
      "properties": {
        "source_material": {"type": "string", "minLength": 1},
        "channel": {"enum": ["email", "blog_post", "internal_memo"]},
        "audience": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "voice_profile_id": {"type": "string", "minLength": 1},
        "constraints": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "content"],
            "properties": {
              "kind": {"enum": ["notes", "reference", "policy", "constraint", "other"]},
              "label": {"type": "string"},
              "content": {"type": "string"}
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creation_method", "lineage_group", "source_document_ids", "style_reference_ids", "license_ids"],
      "properties": {
        "creation_method": {"enum": ["human_revision", "paired_history", "synthetic_degradation"]},
        "lineage_group": {"type": "string", "minLength": 1},
        "source_document_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "style_reference_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "license_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_url": {"type": "string", "format": "uri"},
        "source_revision": {"type": "string"}
      }
    }
  }
}
