{
  "$id": "https://goodprose.local/schemas/unified-pilot-source-record-v1.json",
  "title": "SourceRecord",
  "$defs": {
    "PreferenceTarget": {
      "additionalProperties": false,
      "properties": {
        "chosen": {
          "minLength": 1,
          "title": "Chosen",
          "type": "string"
        },
        "rejected": {
          "minLength": 1,
          "title": "Rejected",
          "type": "string"
        },
        "rejection_reasons": {
          "items": {
            "enum": [
              "unsupported_claim",
              "intent_change",
              "caveat_loss",
              "number_error",
              "attribution_error",
              "unnecessary_rewrite",
              "verbosity",
              "organization",
              "audience_mismatch"
            ],
            "type": "string"
          },
          "title": "Rejection Reasons",
          "type": "array"
        }
      },
      "required": [
        "chosen",
        "rejected",
        "rejection_reasons"
      ],
      "title": "PreferenceTarget",
      "type": "object"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "properties": {
        "ownership": {
          "const": "project_owned",
          "title": "Ownership",
          "type": "string"
        },
        "named_source": {
          "default": null,
          "title": "Named Source",
          "type": "null"
        },
        "external_source_used": {
          "const": false,
          "default": false,
          "title": "External Source Used",
          "type": "boolean"
        },
        "personal_private_data": {
          "const": false,
          "default": false,
          "title": "Personal Private Data",
          "type": "boolean"
        },
        "transformation_history": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Transformation History",
          "type": "array"
        }
      },
      "required": [
        "ownership",
        "transformation_history"
      ],
      "title": "SourceProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "example_id": {
      "minLength": 1,
      "title": "Example Id",
      "type": "string"
    },
    "lineage_group": {
      "minLength": 1,
      "title": "Lineage Group",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "valid",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "corpus": {
      "enum": [
        "task_pair",
        "style_target",
        "preference_pair"
      ],
      "title": "Corpus",
      "type": "string"
    },
    "profile_id": {
      "enum": [
        "concise-decision-v1",
        "technical-explanatory-v1",
        "operational-update-v1"
      ],
      "title": "Profile Id",
      "type": "string"
    },
    "genre": {
      "enum": [
        "email",
        "memo",
        "strategy_document",
        "engineering_document",
        "blog_post",
        "short_post",
        "revision"
      ],
      "title": "Genre",
      "type": "string"
    },
    "creation_method": {
      "const": "codex_project_authored_v1",
      "title": "Creation Method",
      "type": "string"
    },
    "authoring_system": {
      "const": "goodprose-unified-pilot-content-v1",
      "title": "Authoring System",
      "type": "string"
    },
    "rights_status": {
      "const": "training_permitted_project_owned_architecture_pilot",
      "title": "Rights Status",
      "type": "string"
    },
    "intended_use": {
      "const": "unified_profile_conditioning_architecture_pilot_only",
      "title": "Intended Use",
      "type": "string"
    },
    "system_prompt": {
      "minLength": 1,
      "title": "System Prompt",
      "type": "string"
    },
    "user_prompt": {
      "minLength": 1,
      "title": "User Prompt",
      "type": "string"
    },
    "assistant_target": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assistant Target"
    },
    "preference": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreferenceTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "system_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "System Sha256",
      "type": "string"
    },
    "user_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "User Sha256",
      "type": "string"
    },
    "target_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Sha256",
      "type": "string"
    },
    "rejected_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejected Sha256"
    },
    "source_provenance": {
      "$ref": "#/$defs/SourceProvenance"
    }
  },
  "required": [
    "version",
    "example_id",
    "lineage_group",
    "split",
    "corpus",
    "profile_id",
    "genre",
    "creation_method",
    "authoring_system",
    "rights_status",
    "intended_use",
    "system_prompt",
    "user_prompt",
    "system_sha256",
    "user_sha256",
    "target_sha256",
    "source_provenance"
  ],
  "type": "object"
}
